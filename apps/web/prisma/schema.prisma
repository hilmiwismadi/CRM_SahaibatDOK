generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// --- Canonical lead record -------------------------------------------------
// Scraped columns are safe to overwrite on re-import; CRM-owned columns
// (pipelineStage, notes, assignedTo, isLost, lostReason, customTags, trial*)
// must NEVER be touched by the staging-import upsert. See
// src/lib/upsertLeadsFromStaging.ts and docs/ARCHITECTURE.md.
model Lead {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googlePlaceId   String   @unique @map("google_place_id")

  // scraped fields
  name            String
  category        String?
  address         String?
  // Mobile/WA-capable number — the one used for WhatsApp matching
  // (packages/shared/src/phone.ts, apps/wa-bridge). Distinct from the
  // office/landline number below, which is display-only.
  phoneRaw        String?  @map("phone_raw")
  phoneNormalized String?  @map("phone_normalized")
  // Office/landline number, stored as-typed (not E.164-normalized — that
  // format assumes a mobile number shape and would mangle a landline).
  // Never used for WhatsApp matching.
  phoneOffice     String?  @map("phone_office")
  website         String?
  email           String?
  instagramUrl    String?  @map("instagram_url")
  // Derived from `address` (or, failing that, googleMapsUrl / a web
  // search) — see src/lib/provinceExtract.ts. Backs the dashboard's
  // group-by-province view.
  province        String?
  rating          Decimal? @db.Decimal(2, 1)
  reviewCount     Int?     @map("review_count")
  priceRange      String?  @map("price_range")
  openHours       Json?    @map("open_hours")
  googleMapsUrl   String?  @map("google_maps_url")

  // Internal sales classification — free text like pipeline_stage_defs'
  // philosophy (not a hardcoded enum), e.g. "solo_doctor" | "klinik_pratama".
  businessType    String?  @map("business_type")

  /// geometry(Point, 4326) — queried via raw SQL (bbox filtering); GiST index added in migration SQL
  geom Unsupported("geometry(Point, 4326)")?
  // Nullable: manually-added leads (dashboard "+ Add Lead") have no
  // geocoded coordinates. /map already defensively filters these out.
  lat  Float?
  lng  Float?

  firstScrapedAt DateTime  @default(now()) @map("first_scraped_at")
  lastScrapedAt  DateTime? @map("last_scraped_at")

  // CRM-owned fields — excluded from the staging-import upsert's DO UPDATE SET
  pipelineStage    String            @default("new") @map("pipeline_stage")
  pipelineStageDef PipelineStageDef  @relation(fields: [pipelineStage], references: [key])
  notes            String?
  assignedTo       String?           @map("assigned_to")
  isLost           Boolean           @default(false) @map("is_lost")
  lostReason       String?           @map("lost_reason")
  customTags       String[]          @default([]) @map("custom_tags")

  // Trial sub-state — only meaningful while pipelineStage = "trial_accepted".
  // See docs/ARCHITECTURE.md "Pipeline stages" for the full state machine.
  trialStartedAt       DateTime? @map("trial_started_at")
  trialHealthStatus    String?   @map("trial_health_status") // actively_using | need_checkup | not_actively_using
  trialHealthUpdatedAt DateTime? @map("trial_health_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities LeadActivity[]
  waContacts WaContact[]

  // Contact chain — CRM-owned pointer to whichever LeadContactNode is
  // currently "active" for chat purposes. Deliberately NOT phoneNormalized
  // (a scraped field the staging-import upsert overwrites on every
  // re-scrape) — null means "use the auto-seeded root node". See
  // src/lib/contactChain.ts and docs/ARCHITECTURE.md.
  activeContactNodeId String?           @map("active_contact_node_id") @db.Uuid
  activeContactNode   LeadContactNode?  @relation("LeadActiveContact", fields: [activeContactNodeId], references: [id], onDelete: SetNull)
  contactNodes        LeadContactNode[] @relation("LeadContactNodes")

  @@index([phoneNormalized], map: "leads_phone_idx")
  @@index([pipelineStage], map: "leads_stage_idx")
  @@index([trialStartedAt], map: "leads_trial_started_idx")
  @@map("leads")
}

/// Configurable pipeline stage catalog — NOT a hardcoded enum. New stages
/// (e.g. whatever comes after "offer_payment") are added by inserting a row
/// here, no code migration required. `leads.pipeline_stage` is a real FK
/// into this table, so a lead can never reference an undefined stage.
model PipelineStageDef {
  key        String   @id
  label      String
  color      String // hex, used for map pins / kanban / legend
  sortOrder  Int      @map("sort_order")
  isTerminal Boolean  @default(false) @map("is_terminal") // pipeline effectively ends here (won/rejected)
  createdAt  DateTime @default(now()) @map("created_at")

  leads             Lead[]
  transitionsFrom   PipelineTransitionDef[] @relation("TransitionFrom")
  transitionsTo     PipelineTransitionDef[] @relation("TransitionTo")

  @@map("pipeline_stage_defs")
}

/// Valid next-stage moves, used to drive "what buttons can I press on this
/// lead right now" in the UI instead of hardcoding the flow in components.
/// Add a row here to open up a new transition — e.g. once the stages that
/// follow "offer_payment" are decided.
model PipelineTransitionDef {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromKey String @map("from_key")
  toKey   String @map("to_key")
  label   String // button label, e.g. "Accept Trial" / "Reject Trial"

  fromStage PipelineStageDef @relation("TransitionFrom", fields: [fromKey], references: [key])
  toStage   PipelineStageDef @relation("TransitionTo", fields: [toKey], references: [key])

  @@unique([fromKey, toKey])
  @@map("pipeline_transition_defs")
}

/// Timeline: stage changes, notes, WA send/receive events, scrape updates.
model LeadActivity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // stage_change | note | wa_message_sent | wa_message_received | scrape_update | manual_edit
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt(sort: Desc)], map: "lead_activities_lead_idx")
  @@map("lead_activities")
}

/// Bridges WhatsApp JIDs to leads via normalized phone number. lead_id is
/// nullable — a WA contact may not (yet) match a scraped lead.
model WaContact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jid             String    @unique
  // Nullable: some @lid (phone-number-privacy) senders never resolve to a
  // real phone number via Baileys' lidMapping store — see apps/wa-bridge's
  // inbound handler. Absence of a phone means "unknown", not empty string.
  phoneNormalized String?   @map("phone_normalized")
  leadId          String?   @map("lead_id") @db.Uuid
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  displayName     String?   @map("display_name")
  linkedAt        DateTime? @map("linked_at")
  // Manual "mark as replied" override — for replies that happened outside
  // this CRM's visibility (e.g. answered directly from the paired phone,
  // or by an external bot) so wa_messages has no record of them. When this
  // is newer than the last inbound message, the conversation no longer
  // shows as needing a reply. Automatically stops applying (reverts to
  // needing a reply) the moment a newer inbound message arrives — a lead
  // following up after a bot reply usually means they want a human, so
  // this is deliberately not a permanent "resolved" flag. Cleared (set
  // back to null) to un-mark early.
  repliedOverrideAt   DateTime? @map("replied_override_at")
  // "manual" (a person replied outside this CRM) or "bot" (an automated
  // reply) — display-only distinction; both expire the same way above.
  repliedOverrideKind String?   @map("replied_override_kind")
  // Manual flag: WhatsApp isn't working for this lead (no response, wrong
  // number, etc.) and they need to be reached another way (email, phone
  // call, etc). Unlike repliedOverrideAt, this does NOT auto-expire on a
  // new inbound message — it's a standing note about the channel, not a
  // reply-status snapshot, so it stays until manually cleared.
  needsOtherContact Boolean @default(false) @map("needs_other_contact")
  // Manual flag: this lead needs a proactive follow-up (e.g. went quiet,
  // said "call me later", waiting on something from them). Same standing
  // semantics as needsOtherContact above — does not auto-expire on a new
  // inbound message, cleared manually when no longer relevant.
  needsFollowUp Boolean @default(false) @map("needs_follow_up")
  // Manual flag: confirmed this phone number has no WhatsApp account (e.g.
  // a landline scraped as the lead's only phone, or the number was
  // mistyped) — distinct from needsOtherContact ("WA isn't working, try
  // something else") in that this is a factual dead-end, not a
  // still-worth-retrying channel problem. Same standing semantics: no
  // auto-expiry, cleared manually. See apps/wa-bridge's sendText() —
  // NotOnWhatsAppError is the automated signal this same fact can also be
  // detected from (not auto-applied to this flag yet, kept manual for now).
  noWaAccount Boolean @default(false) @map("no_wa_account")
  // Manual flag: a meeting/appointment has been scheduled with this lead —
  // a positive milestone, distinct from the other standing flags above
  // (which all mark problems). Same no-auto-expiry semantics; cleared
  // manually once the appointment has passed or fallen through.
  appointment Boolean @default(false)
  // Manual flag: lead explicitly said no (with or without a stated
  // reason) — a confirmed dead end, same tier as appointment but the
  // negative outcome. Kept manual because decline wording is too varied
  // to detect reliably from message text alone (see the 2026-09-12
  // chat-history review that first identified this gap — Erika Dian
  // Puspitasari's "tidak melayani BPJS" was sitting under needsFollowUp
  // with nowhere else to go). Same no-auto-expiry semantics as the flags
  // above.
  declined Boolean @default(false)
  // Manual flag: BD sent this lead a formal invitation letter (see
  // /letters) — a standing note about outreach history, not a funnel
  // outcome, so it's deliberately NOT auto-set when a PDF is generated
  // (a letter can be sent outside the tool too — printed, emailed
  // manually). Low priority in classifyLead: only shown once no other
  // funnel category applies, since it doesn't say anything about whether
  // the lead is interested or has replied. Same no-auto-expiry semantics
  // as the flags above.
  letterSent Boolean @default(false) @map("letter_sent")

  messages    WaMessage[]
  contactNode LeadContactNode?

  @@index([phoneNormalized], map: "wa_contacts_phone_idx")
  @@map("wa_contacts")
}

model WaMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waContactId String    @map("wa_contact_id") @db.Uuid
  waContact   WaContact @relation(fields: [waContactId], references: [id], onDelete: Cascade)
  waMessageId String    @unique @map("wa_message_id") // Baileys message key id, dedupe on ingest
  direction   String // inbound | outbound
  body        String?
  messageType String    @default("text") @map("message_type")
  rawPayload  Json?     @map("raw_payload") // full Baileys message object, future-proofing
  sentAt      DateTime  @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([waContactId, sentAt], map: "wa_messages_contact_idx")
  @@map("wa_messages")
}

/// A node in a lead's "who gave us this contact" chain. One node = one
/// person we've dealt with for this lead. `isRoot` marks the auto-seeded
/// node representing the originally-scraped contact (see
/// src/lib/contactChain.ts); every other node has a parent recording a
/// handoff (e.g. doctor -> administrative/marketing staff). `phoneNormalized`
/// is a frozen snapshot taken at node-creation time — NOT kept in sync with
/// re-scrapes — so it never drifts out from under messages already sent to
/// that number. `waContactId` links to the actual WaContact/conversation
/// once one exists for that phone (may lag behind creation, or never
/// resolve for @lid-only contacts — see apps/wa-bridge's LID handling).
model LeadContactNode {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation("LeadContactNodes", fields: [leadId], references: [id], onDelete: Cascade)

  parentId String?           @map("parent_id") @db.Uuid
  parent   LeadContactNode?  @relation("ContactChainParent", fields: [parentId], references: [id], onDelete: SetNull)
  children LeadContactNode[] @relation("ContactChainParent")

  waContactId String?    @unique @map("wa_contact_id") @db.Uuid
  waContact   WaContact? @relation(fields: [waContactId], references: [id], onDelete: SetNull)

  phoneNormalized String? @map("phone_normalized")
  displayName     String? @map("display_name")
  role            String? // free text, e.g. "doctor" | "admin_staff" | "marketing" — same philosophy as pipeline_stage_defs, not a hardcoded enum
  handoffNote     String? @map("handoff_note")
  isRoot          Boolean  @default(false) @map("is_root")
  createdAt       DateTime @default(now()) @map("created_at")

  activeForLeads Lead[] @relation("LeadActiveContact")

  @@index([leadId], map: "lead_contact_nodes_lead_idx")
  @@index([phoneNormalized], map: "lead_contact_nodes_phone_idx")
  @@map("lead_contact_nodes")
}

/// A reusable outbound message template — plain CRUD, no LLM generation
/// (deferred). Selected manually in the chat Composer to fill the textarea.
model MessageTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  category  String   @default("general")
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

model ScrapeJob {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryText        String    @map("query_text")
  geoParams        Json?     @map("geo_params")
  status           String    @default("running") // running | completed | failed | imported
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  rawResultCount   Int?      @map("raw_result_count")
  newLeadCount     Int?      @map("new_lead_count")
  updatedLeadCount Int?      @map("updated_lead_count")
  notes            String?

  stagingResults StgScrapeResult[]

  @@map("scrape_jobs")
}

/// Raw landing table for gosom/google-maps-scraper's native Postgres writer.
/// Never read directly by the UI — only by the staging-import upsert job.
model StgScrapeResult {
  id            BigInt     @id @default(autoincrement())
  scrapeJobId   String?    @map("scrape_job_id") @db.Uuid
  scrapeJob     ScrapeJob? @relation(fields: [scrapeJobId], references: [id])
  googlePlaceId String?    @map("google_place_id")
  name          String?
  category      String?
  address       String?
  phone         String?
  website       String?
  email         String?
  lat           Float?
  lng           Float?
  rating        Decimal?   @db.Decimal(2, 1)
  reviewCount   Int?       @map("review_count")
  priceRange    String?    @map("price_range")
  openHours     Json?      @map("open_hours")
  rawJson       Json?      @map("raw_json") // catch-all for anything not mapped to a column
  importedAt    DateTime?  @map("imported_at") // null until merged into `leads`

  @@map("stg_scrape_results")
}
