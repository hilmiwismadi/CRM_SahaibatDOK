# Copy to .env and adjust as needed. Never commit the real .env.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=sahaibat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sahaibat_mapping

# Full connection string used by web/wa-bridge/Prisma.
# When running web/wa-bridge on the host (not in Docker), use localhost:5433
# — the container publishes on 5433, not 5432, to avoid clashing with a
# native Postgres install some machines already run on 5432:
DATABASE_URL=postgresql://sahaibat:change-me@localhost:5433/sahaibat_mapping
# When running web/wa-bridge inside docker compose, use the service name +
# its internal port (5432) instead:
# DATABASE_URL=postgresql://sahaibat:change-me@db:5432/sahaibat_mapping

# --- wa-bridge ---------------------------------------------------------------
PORT=3001
# URL the `web` app uses to reach wa-bridge's internal API.
WA_BRIDGE_INTERNAL_URL=http://localhost:3001

# --- Caddy (prod only, see docs/DEPLOY.md) -----------------------------------
# DOMAIN=leads.yourdomain.com
# BASIC_AUTH_USER=hilmi
# BASIC_AUTH_PASSWORD_HASH=  # generate with: caddy hash-password
