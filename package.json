{
  "name": "sahaibat-mapping",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:wa-bridge": "npm run dev --workspace=@sahaibat/wa-bridge",
